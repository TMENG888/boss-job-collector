{
  "manifest_version": 3,
  "name": "BOSS岗位采集助手",
  "version": "1.3.5",
  "description": "开源岗位采集工具：逐屏增量采集、自动翻页、多关键词接力、薪资字体解密、JD详情抓取，达到设定数量自动停止。仅供个人求职与学习研究使用。",
  "homepage_url": "https://github.com/TMENG888/boss-job-collector",
  "permissions": ["storage", "downloads", "scripting", "alarms"],
  "host_permissions": ["https://www.zhipin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BOSS岗位采集助手"
  }
}
